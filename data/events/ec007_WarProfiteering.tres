[sub_resource type="Resource" id="Resource_ngkx1"]
script = ExtResource("1_fb7ce")
text = "Secretly sell arms and supplies to both sides."
success_text = "A masterstroke of ruthless profiteering! Your agents covertly sell weapons, grain, and supplies to both warring kingdoms, taking their desperate gold. Your treasury overflows as their lands burn."
failure_text = "Your agents are clumsy and are caught dealing with both sides. Outraged at your two-faced treachery, both kingdoms declare you an enemy. You have managed to unite them against you!"
skill_check = SubResource("Resource_fb7ce")
