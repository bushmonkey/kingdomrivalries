[resource]
script = ExtResource("4_vmebe")
category = 1
trigger_conditions = SubResource("Resource_jd54b")
event_id = "EC007"
title = "Vultures Circle"
unlocked_at_start = true
rarity = 2
cooldown_years = 0
selection_cost = 100
summary = "Two of your neighboring kingdoms are at war, creating a unique and potentially profitable opportunity for you."
description = "War has erupted between the {attacker_kingdom_name} and the {defender_kingdom_name}. Their armies are on the march, and their treasuries are bleeding gold to pay for steel and soldiers.

Your steward approaches you with a sly look. \"My Liege,\" he says quietly, \"a neighbor's war is another's fortune. Both sides are desperate for supplies and coin. A 'neutral' kingdom such as ours is in a prime position to profit from their bloodshed.\""
vignette_texture = ""
options = Array[ExtResource("1_fb7ce")]([SubResource("Resource_ngkx1"), SubResource("Resource_hhvfi"), SubResource("Resource_bkk0f"), SubResource("Resource_oofff")])
