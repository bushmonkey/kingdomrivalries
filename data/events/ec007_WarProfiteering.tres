[sub_resource type="Resource" id="Resource_hhvfi"]
script = ExtResource("1_fb7ce")
text = "Offer a loan to the attacker, {attacker_kingdom_name}."
success_text = "The {attacker_kingdom_name} gratefully accepts your loan. You have earned their friendship and will receive a tidy profit in interest once the war is over. A shrewd investment."
failure_text = "Your gift is seen not as a gesture of friendship, but as the act of a pity that affronts your neighbor. They accept the timber, but their opinion of you plummets. You have given away a fortune for nothing."
