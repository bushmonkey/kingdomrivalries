[sub_resource type="Resource" id="Resource_ahuha"]
script = ExtResource("1_y0en5")
text = "\"To the training yard! Let's see if you've gotten any slower.\""
success_text = "The clash of blunted steel echoes in the training yard. The spar is exhilarating, a fierce but friendly contest of skill that reminds you both of your younger days. The exercise invigorates you, sharpening both your body and your mind."
failure_text = "The spar is a clumsy affair. You are both rusty, and an accidental, painful blow brings the match to an awkward and early end. You are left feeling old and out of practice."
skill_check = SubResource("Resource_2h5hy")
required_gold = 0
required_manpower = 0
required_food = 0
required_modifier = ""
success_outcomes = Array[ExtResource("2_c7fr8")]([SubResource("Resource_nn5ky")])
