[sub_resource type="Resource" id="Resource_j0b8t"]
script = ExtResource("1_y0en5")
text = "\"Welcome. Grant them a formal audience, as befits their station.\""
success_text = "You receive your friend with all the formality of the court. The conversation is polite, but brief and impersonal. You have shown the court that you are a king first and a man second. Your friend leaves the next day, the unspoken distance between you now a vast chasm."
failure_text = "Failure!"
required_gold = 0
required_manpower = 0
required_food = 0
