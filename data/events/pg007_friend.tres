[sub_resource type="Resource" id="Resource_krqi7"]
script = ExtResource("1_y0en5")
text = "\"Friend! Dismiss the court! We have years of catching up to do.\""
success_text = "You spend the rest of the day in private conversation, sharing stories and laughing as if no time has passed at all. The weight of the crown feels a little lighter. Reconnecting with your past has reminded you of the person you are, not just the ruler you have become."
failure_text = "You try to reconnect, but the gap between you is too great. You are a ruler and they are a commoner, and the old ease between you is gone, replaced by a polite but awkward distance. The past, it seems, is another country."
skill_check = SubResource("Resource_xhcdh")
required_gold = 0
required_manpower = 0
required_food = 0
required_modifier = ""
success_outcomes = Array[ExtResource("2_c7fr8")]([SubResource("Resource_r4sgw")])
failure_outcomes = Array[ExtResource("2_c7fr8")]([SubResource("Resource_6s03t")])
metadata/_custom_type_script = "uid://cohvc8fiel25u"

