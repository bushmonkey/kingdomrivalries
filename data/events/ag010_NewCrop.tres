[sub_resource type="Resource" id="Resource_14774"]
script = ExtResource("1_u46np")
text = "\"Order the peasants to plant it.\""
success_text = "You distribute the seeds to the royal farms. The peasants are skeptical, but the new turnips prove to be as hardy as the monk claimed. Your kingdom's food supply is now more resilient."
failure_text = "The peasants, resistant to change, plant the seeds incorrectly or not at all. The crop fails. Your attempt to innovate has been thwarted by stubborn tradition."
skill_check = SubResource("Resource_u46np")
required_gold = 0
required_manpower = 0
required_food = 0
required_modifier = ""
success_outcomes = Array[ExtResource("2_6i30o")]([SubResource("Resource_cjm8p")])
failure_outcomes = Array[ExtResource("2_6i30o")]([SubResource("Resource_6i30o")])
metadata/_custom_type_script = "uid://cohvc8fiel25u"

[sub_resource type="Resource" id="Resource_ygk0o"]
script = ExtResource("1_u46np")
text = "\"An interesting experiment but I'll pass.\""
success_text = "You thank the monk for his diligence but decline to implement the new crop. Your kingdom's agriculture remains unchanged."
failure_text = "Failure!"
