[sub_resource type="Resource" id="Resource_8ef2o"]
script = ExtResource("1_ncc6g")
text = "\"Visit them. I would learn of their purpose.\""
success_text = "You make the arduous journey to the abbey. The monks are wary but respectful. Their abbot is an ancient, wise man who has preserved ancient texts lost to the rest of the world. Impressed by your humility, he allows you to study with them, greatly enhancing your own knowledge."
failure_text = "You visit the abbey, but your presence is seen as an intrusion. The monks are secretive and hostile, and you learn nothing. The journey was a waste of time."
skill_check = SubResource("Resource_emyl2")
required_gold = 0
required_manpower = 0
required_food = 0
required_modifier = ""
success_outcomes = Array[ExtResource("2_01o0k")]([SubResource("Resource_rncve"), SubResource("Resource_of60h")])
failure_outcomes = Array[ExtResource("2_01o0k")]([SubResource("Resource_01o0k")])
metadata/_custom_type_script = "uid://cohvc8fiel25u"

