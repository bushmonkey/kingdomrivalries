text = "\"They are unsanctioned. Demand they submit to the Bishop.\""
success_text = "You send a decree ordering the monks to submit to the authority of your Bishop. They reluctantly agree. The Church is pleased that you have brought this rogue element to heel, and it gains a new source of tithes."
