[sub_resource type="Resource" id="Resource_nuo6w"]
script = ExtResource("1_hpnv0")
text = "\"Speak of power, legacy, and a great dynasty.\""
success_text = "You speak of your ambitions for the kingdom, of conquest and a legacy that will last a thousand years. She listens, her eyes alight with the same fire. You have found a partner whose ambition matches your own."
failure_text = "Your talks of conquests and blood are met with horror. Lady {girlfriend_name} cannot believe her ears and she runs away crying, terrified of what her life would be like with you."
