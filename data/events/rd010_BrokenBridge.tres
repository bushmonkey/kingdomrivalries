[resource]
script = ExtResource("2_myi8l")
category = 0
event_id = "RD010"
title = "The bridge needs repairs"
unlocked_at_start = false
rarity = 1
cooldown_years = 0
selection_cost = 0
summary = "The temporary wooden bridge built years ago is becoming dangerously unstable and needs proper repairs."
description = "Your steward brings a worrying report. \"My Liege, you may recall we built a temporary wooden bridge over the river some years ago. The wood is now rotting and the structure groans under the weight of heavy carts. It is only a matter of time before it collapses completely, once again severing our main trade route. We must replace it with a proper stone bridge.\""
vignette_texture = ""
options = Array[ExtResource("1_lx665")]([SubResource("Resource_32yg1"), SubResource("Resource_4f4v6")])
metadata/_custom_type_script = "uid://cv44sc5a1ixbf"
