[sub_resource type="Resource" id="Resource_32yg1"]
script = ExtResource("1_lx665")
text = "\"You are right. It is time for a permanent solution.\""
success_text = "The old wooden bridge is dismantled and replaced with a magnificent stone structure. It is a costly project, but it secures the trade route for centuries to come. The merchants and people are grateful for your foresight."
failure_text = "The new stone bridge is a disaster. Poor craftsmanship and shoddy materials lead to a partial collapse during construction. The final cost of the project is far greater than anticipated."
skill_check = SubResource("Resource_obedd")
required_gold = 400
required_manpower = 0
required_food = 0
required_modifier = ""
success_outcomes = Array[ExtResource("2_p8r3x")]([SubResource("Resource_p8r3x"), SubResource("Resource_lfudb")])
failure_outcomes = Array[ExtResource("2_p8r3x")]([SubResource("Resource_6lmd1"), SubResource("Resource_cxcis")])
metadata/_custom_type_script = "uid://cohvc8fiel25u"

