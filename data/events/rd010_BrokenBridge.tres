[sub_resource type="Resource" id="Resource_4f4v6"]
script = ExtResource("1_lx665")
text = "\"We cannot afford that. Just patch the wooden bridge for now.\""
success_text = "Your workers replace the most rotten timbers and reinforce the supports. The bridge is a little less wobbly, for now. You have bought yourself a few more years, but the problem will inevitably return."
failure_text = "Failure!"
required_gold = 0
required_manpower = 0
required_food = 0
