script = ExtResource("1_maw6u")
text = "Host a grand feast in his honor."
success_text = "The feast is a magnificent success. You showcase the best of your kingdom's hospitality. The dignitary is pleased by the honor you have shown him and his ruler."
failure_text = "The feast is a disaster. The food is bland, the music is provincial, and the dignitary seems utterly bored. He is clearly unimpressed by your court's lack of sophistication."
