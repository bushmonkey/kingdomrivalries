[resource]
script = ExtResource("2_1604l")
category = 0
event_id = "RD011"
title = "A Visiting Dignitary"
unlocked_at_start = true
rarity = 0
cooldown_years = 0
selection_cost = 0
summary = "An important envoy from a powerful, distant kingdom is visiting your court, and you must find a way to impress them."
description = "A high-ranking dignitary from a powerful southern Caliphate has arrived on a diplomatic mission. He is a worldly and sophisticated man, not easily impressed by the simple pleasures of your northern court. Your relationship with his powerful kingdom could be greatly influenced by the impression you make during his visit."
