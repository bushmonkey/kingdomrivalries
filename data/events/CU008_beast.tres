[sub_resource type="Resource" id="Resource_7f6g6"]
script = ExtResource("1_o5cna")
text = "\"A king does not buy what is rightfully his. Seize the beast.\""
success_text = "Your guards surround the merchant's entourage. Intimidated by your show of force, they surrender the lion without a fight. The beast is yours, a testament to your absolute power. Your nobles are awed by your audacity."
failure_text = "The merchant and his guards are not so easily cowed! They fight back fiercely to protect their valuable prize. A bloody skirmish breaks out in the courtyard. You eventually take the lion, but not before several of your own men are wounded and your reputation as a brutish tyrant spreads to foreign merchant guilds."
skill_check = SubResource("Resource_nlmld")
required_gold = 0
required_manpower = 0
required_food = 0
required_modifier = ""
success_outcomes = Array[ExtResource("2_kwmog")]([SubResource("Resource_kinc1"), SubResource("Resource_2sk58")])
failure_outcomes = Array[ExtResource("2_kwmog")]([SubResource("Resource_michu"), SubResource("Resource_tadph")])
