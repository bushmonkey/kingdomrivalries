[resource]
script = ExtResource("2_c73nq")
category = 5
event_id = "CU009"
title = "The Philosopher's Visit"
unlocked_at_start = true
rarity = 0
cooldown_years = 0
selection_cost = 0
summary = "A traveling philosopher known for his controversial ideas has arrived at your court, requesting your patronage."
description = "A renowned but controversial philosopher has arrived in your kingdom. He is known for his lectures on logic, reason, and governance—ideas that many nobles find intriguing but the Church considers dangerously secular. He requests your patronage to hold a series of debates at court."
