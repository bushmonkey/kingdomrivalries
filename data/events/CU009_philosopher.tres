[sub_resource type="Resource" id="Resource_vh4c7"]
script = ExtResource("1_5ag76")
text = " \"Patronize him. A ruler should not fear new ideas.\" "
success_text = "You welcome the philosopher. The debates he hosts are a sensation, sparking a new wave of intellectual curiosity throughout your court. Your reputation as an enlightened and confident ruler grows."
failure_text = "The philosopher's debates are a disaster. He openly mocks cherished beliefs, offending both your nobles and the clergy. Your court is seen as a haven for radical and dangerous ideas."
