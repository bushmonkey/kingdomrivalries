[resource]
script = ExtResource("2_f83tt")
category = 3
event_id = "MF012"
title = "The Quarry Dispute"
unlocked_at_start = true
rarity = 0
cooldown_years = 0
selection_cost = 0
summary = "Your Marshal and your Steward are arguing over the primary use for the stone from the royal quarry."
description = "Your Marshal and your Steward are in a heated argument. \"The stone from the quarry must be used to reinforce the castle walls!\" the Marshal insists.

\"Nonsense!\" the Steward retorts. \"That stone is needed for the new marketplace and guildhall! The city's economy is more important than another layer of stone on a wall that has never been breached!\" They both turn to you for the final decision."
vignette_texture = ""
options = Array[ExtResource("1_txmvo")]([SubResource("Resource_56p5x"), SubResource("Resource_1566e"), SubResource("Resource_a6kdl")])
metadata/_custom_type_script = "uid://cv44sc5a1ixbf"
