[sub_resource type="Resource" id="Resource_m5xdv"]
script = ExtResource("1_xdour")
text = "\"Rebuild it with stone, stronger than before.\" "
success_text = "You hire the best stonemasons in the realm. They work tirelessly to construct a new, stronger bridge with reinforced arches. Trade is restored, and the new bridge stands as a proud symbol of your reign's commitment to infrastructure."
failure_text = "Even with the advanced knowledge, a critical The master mason is a cheat who uses poor quality mortar. The new bridge is unstable and costs a fortune in additional repairs. The entire project is a costly embarrassment."
skill_check = SubResource("Resource_wh46y")
required_gold = 100
required_manpower = 0
required_food = 0
required_modifier = "AdvancedArchitecture"
success_outcomes = Array[ExtResource("2_qersi")]([SubResource("Resource_14rxi"), SubResource("Resource_mbm7r")])
failure_outcomes = Array[ExtResource("2_qersi")]([SubResource("Resource_14rxi"), SubResource("Resource_24u4x")])
metadata/_custom_type_script = "uid://cohvc8fiel25u"

