[resource]
script = ExtResource("4_0eeqi")
category = 3
event_id = "MF011"
title = "The Broken Bridge"
unlocked_at_start = true
rarity = 0
cooldown_years = 0
selection_cost = 0
summary = "A vital stone bridge on the main trade route has collapsed after a flood, disrupting commerce."
description = "A messenger arrives with bad news. The Old Stone Bridge, a crucial crossing on the main trade route into your capital, has been damaged by recent floods and is now impassable. Merchant carts are backed up for miles, and local commerce is grinding to a halt. The bridge must be repaired."
vignette_texture = ""
options = Array[ExtResource("1_xdour")]([SubResource("Resource_m5xdv"), SubResource("Resource_3hisl"), SubResource("Resource_cealr")])
metadata/_custom_type_script = "uid://cv44sc5a1ixbf"
