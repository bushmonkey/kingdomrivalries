[sub_resource type="Resource" id="Resource_3hisl"]
script = ExtResource("1_xdour")
text = "\"A quick fix with wood is all we can afford.\""
success_text = "Your engineers quickly construct a sturdy wooden bridge over the river. It's not as permanent as stone, but it gets the trade route open again. The merchants are relieved."
failure_text = "The wooden construction is plagued with leaks and rot from the start. It provides a mere trickle of water and is seen as a shoddy, half-hearted effort by the people."
required_gold = 75
required_manpower = 0
required_food = 0
required_modifier = ""
