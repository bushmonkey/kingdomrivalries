[resource]
script = ExtResource("2_kd4o1")
category = 6
event_id = "PG009"
title = "Like Old Times"
unlocked_at_start = false
rarity = 0
cooldown_years = 0
selection_cost = 0
summary = "Your childhood friend, now a member of your court, suggests sneaking out for a night of mischief like you did when you were young."
description = "Late one evening, {friend_name} comes to your chambers with a mischievous glint in their eye. \"My Liege,\" they whisper, \"this is all very grand, but don't you ever miss the old days? Just for one night, let's forget the crown. Let's sneak down to the tavern in common clothes, share a cheap ale, and maybe play a few pranks on the city watch. Just like old times.\""
vignette_texture = ""
options = Array[ExtResource("1_fo1ok")]([SubResource("Resource_4bk6t"), SubResource("Resource_v103p"), SubResource("Resource_ddpbp")])
metadata/_custom_type_script = "uid://cv44sc5a1ixbf"
