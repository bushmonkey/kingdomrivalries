[sub_resource type="Resource" id="Resource_v103p"]
script = ExtResource("1_fo1ok")
text = "\"A drink with my subjects sounds perfect, but let's leave the pranks for another time.\""
success_text = "You and your friend spend the evening in the corner of a noisy tavern, listening to the songs and stories of the common folk. They have no idea who you are. The experience is grounding, giving you a rare and honest insight into the lives of the people you rule."
failure_text = "You try to blend in, but your noble bearing and fine clothes (even your \"common\" ones) give you away. The tavern falls silent as people recognize you, and the night becomes a formal, awkward affair. The chance for a genuine connection is lost."
skill_check = SubResource("Resource_kwuc8")
required_gold = 0
required_manpower = 0
required_food = 0
required_modifier = ""
success_outcomes = Array[ExtResource("2_ovc85")]([SubResource("Resource_avlmu")])
failure_outcomes = Array[ExtResource("2_ovc85")]([SubResource("Resource_t0fbd")])
metadata/_custom_type_script = "uid://cohvc8fiel25u"

