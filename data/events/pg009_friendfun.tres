[sub_resource type="Resource" id="Resource_4bk6t"]
script = ExtResource("1_fo1ok")
text = "\"Lead the way! Let's see if the Captain of the Watch still has no sense of humor.\""
success_text = "The night is a riot of laughter and nostalgia. You successfully swap the watch's banner with the baker's sign for a pig, share stories with unsuspecting commoners, and make it back to the castle before dawn, undetected. The thrill of it all has sharpened your wits."
failure_text = "Your prank on the city watch goes horribly wrong. You are almost caught, and in the clumsy escape, you drop a glove bearing the royal crest. The next day, the entire city is gossiping about the king's childish and disruptive behavior. It is a royal embarrassment."
skill_check = SubResource("Resource_jbdga")
required_gold = 0
required_manpower = 0
required_food = 0
required_modifier = ""
success_outcomes = Array[ExtResource("2_ovc85")]([SubResource("Resource_omfuk")])
failure_outcomes = Array[ExtResource("2_ovc85")]([SubResource("Resource_ovc85")])
metadata/_custom_type_script = "uid://cohvc8fiel25u"

