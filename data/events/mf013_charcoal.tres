[resource]
script = ExtResource("2_w4pxu")
category = 3
event_id = "MF013"
title = "The Charcoal Burners"
unlocked_at_start = true
rarity = 0
cooldown_years = 0
selection_cost = 0
summary = "The charcoal burners who supply your forges are clearing huge swathes of the forest, angering the local hunters and villagers."
description = "A delegation of villagers petitions you. \"My Liege, the charcoal burners are a plague! They have cleared half the ancient woods to feed the forges. The game has fled, the streams are choked with ash, and our children cough from the smoke.\"

Later, the guild master argues, \"Without our charcoal, every forge in your kingdom goes cold. There can be no swords, no plows, no nails. Our work is vital!\""
vignette_texture = ""
options = Array[ExtResource("1_28r7b")]([SubResource("Resource_gs6we"), SubResource("Resource_riwq3"), SubResource("Resource_5v27d")])
metadata/_custom_type_script = "uid://cv44sc5a1ixbf"
