script = ExtResource("1_28r7b")
text = "\"Relocate them. Find a new forest to exploit.\""
success_text = "Your steward finds a suitable, uninhabited woodland far from any villages. The burners are relocated at some expense, but now both the villagers and the forges are satisfied."
failure_text = "The relocation is a poorly planned disaster. The new location is unsuitable, and production grinds to a halt for a season, causing a shortage of fuel. The effort was a costly failure."
