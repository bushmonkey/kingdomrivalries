[resource]
script = ExtResource("2_kv3uk")
category = 5
trigger_conditions = SubResource("Resource_r1x8q")
event_id = "CU007"
title = "Heretical Pamphlets"
unlocked_at_start = true
rarity = 0
cooldown_years = 0
selection_cost = 0
summary = "Anonymous pamphlets questioning the Church's doctrines are circulating in the capital."
description = "Your spymaster brings you a crudely printed pamphlet that is being secretly passed around the capital's taverns and workshops. It contains a series of questions challenging the Bishop's wealth and the Church's divine authority. The Bishop is furious and demands you find and burn the source of this heresy."
vignette_texture = ""
options = Array[ExtResource("1_06mwc")]([SubResource("Resource_fsc24"), SubResource("Resource_1ujlq"), SubResource("Resource_32sdb")])
