[sub_resource type="Resource" id="Resource_fsc24"]
script = ExtResource("1_06mwc")
text = "\"Uphold the Faith. Find and burn this printing press.\""
success_text = "Your spies successfully locate the secret printing press. It is destroyed, and the heretics are handed over to the Church for judgment. The Bishop praises your decisive action."
failure_text = "Your spies find nothing. The pamphlets continue to circulate, undermining the Church's authority and making you look incompetent."
