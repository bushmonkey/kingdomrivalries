text = "\"Secretly fund them. Undermine the Bishop's power.\" "
success_text = "You covertly send a pouch of unmarked coins to the printers. Their production increases, and their pamphlets become more widespread. The Bishop's authority is weakened, which may prove useful to you, but you are playing a very dangerous game."
failure_text = "Failure!"
