[resource]
script = ExtResource("4_cniys")
category = 2
event_id = "AG009"
title = "Poachers in the Royal Wood"
unlocked_at_start = true
rarity = 0
cooldown_years = 0
selection_cost = 0
summary = "Your royal gamekeeper reports that poachers are illegally hunting deer in your personal forests."
description = "Your gamekeeper reports that poachers have been active in the King's Wood. \"They are stealing the King's deer, my Liege!\" he fumes. \"It is an insult to your authority and depletes the stocks for the royal hunt.\""
vignette_texture = ""
options = Array[ExtResource("1_krbt8")]([SubResource("Resource_14774"), SubResource("Resource_ygk0o"), SubResource("Resource_q5jhp")])
