[sub_resource type="Resource" id="Resource_14774"]
script = ExtResource("1_krbt8")
text = "\"Make an example of them. Hang any poacher caught.\" "
success_text = "Your command is firm and just. Lord Aldred, Your decree is carried out. A few unlucky poachers are caught and hanged, their bodies left as a warning. The poaching stops. The nobles are pleased that the law is upheld, but the common folk see the punishment as overly cruel for a man trying to feed his family."
failure_text = "Your decree is carried out. A few unlucky poachers are caught and hanged, their bodies left as a warning. The poaching stops. The nobles are pleased that the law is upheld, but the common folk see the punishment as overly cruel for a man trying to feed his family."
required_gold = 0
required_manpower = 0
required_food = 0
required_modifier = ""
