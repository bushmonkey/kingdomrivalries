[sub_resource type="Resource" id="Resource_q5jhp"]
script = ExtResource("1_krbt8")
text = "\"Organize a controlled cull. Distribute the meat.\""
success_text = "You announce a royal cull of the deer herd, framed as a gesture of goodwill. You distribute the excess meat to the villages. The peasants get their food, the nobles get a hunt, and you are seen as a wise and generous ruler who provides for all his subjects."
failure_text = "The cull is poorly organized and seen as a token gesture. Not enough meat is distributed to make a difference, and the poachers simply see it as a chance to hunt more easily. The effort is wasted."
skill_check = SubResource("Resource_hkdso")
required_gold = 50
required_manpower = 0
required_food = 0
required_modifier = ""
