[sub_resource type="Resource" id="Resource_ygk0o"]
script = ExtResource("1_krbt8")
text = "\"They must be desperate. Turn a blind eye.\""
success_text = "You quietly order your gamekeeper to ease his patrols. The peasants are able to hunt enough to supplement their meager diets. They are grateful for your unspoken mercy, but the nobles are furious that you are allowing the law to be flouted."
failure_text = "Failure!"
