[sub_resource type="Resource" id="Resource_kp8kr"]
script = ExtResource("1_ff01q")
text = "\"A lavish necklace of gold and gems.\""
success_text = "She is dazzled by the exquisite necklace. She accepts it with a gasp of delight, impressed by your wealth and generosity. The gift is the talk of the court."
failure_text = "The necklace, though expensive, is gaudy and ill-suited to her taste. She accepts it politely, but you can tell she sees it as a vulgar display of wealth."
