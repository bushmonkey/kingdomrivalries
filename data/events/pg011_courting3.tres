[sub_resource type="Resource" id="Resource_jad2k"]
script = ExtResource("1_ff01q")
text = "\"A fine dagger from the royal armory.\""
success_text = "Her eyes light up as she tests the dagger's perfect balance. \"A gift with an edge,\" she says with a wry smile, \"I like it.\" She is impressed by your recognition of her strength and spirit."
failure_text = "She looks at the dagger with alarm. \"Do you think me some brutish shieldmaiden?\" she asks, clearly offended. You have badly misjudged her character."
skill_check = SubResource("Resource_qgcdw")
