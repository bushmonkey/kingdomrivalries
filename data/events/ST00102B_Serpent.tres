[sub_resource type="Resource" id="Resource_cmv40"]
script = ExtResource("1_081jk")
text = " \"Confront him with it privately.\""
success_text = "You show Valerius the proof in private. He turns pale, his composure cracking for the first time. Trapped, he agrees to abandon his conspiracy in exchange for your silence. You have won, but now hold a dangerous secret."
failure_text = "He laughs in your face. \"Do it,\" he dares. \"Release it. My followers will see it as a desperate lie.\" He is completely unintimidated. Your gambit has failed, and he now knows what you have on him."
required_gold = 0
required_manpower = 0
required_food = 0
required_modifier = ""
success_outcomes = Array[ExtResource("2_fogut")]([SubResource("Resource_pnqad")])
failure_outcomes = Array[ExtResource("2_fogut")]([SubResource("Resource_fgkpl")])
metadata/_custom_type_script = "uid://cohvc8fiel25u"

[resource]
