title = "A Piece of Blackmail"
unlocked_at_start = true
rarity = 0
cooldown_years = 0
selection_cost = 0
summary = "Your spymaster has uncovered a dark secret from your uncle's past that could be used as leverage."
description = "Your spymaster brings you a sealed document. \"My Liege, we have found it,\" he says with a grim smile. \"Proof that Lord Valerius embezzled funds from your father's treasury years ago. It is a secret he has guarded jealously. We could use this to ruin him, but blackmail is a dirty and unpredictable weapon.\""
