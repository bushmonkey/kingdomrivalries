[sub_resource type="Resource" id="Resource_wm6t0"]
script = ExtResource("1_081jk")
text = "\"Use it. Destroy his reputation.\""
success_text = "You leak the documents. The scandal explodes in the court. The revelation that Valerius stole from his own brother shatters his credibility. Many of his supporters abandon him, seeing him not as a righteous claimant, but as a common thief."
failure_text = "Valerius, ever the cunning politician, skillfully turns the scandal around. He claims the documents are forgeries planted by you, a paranoid king. You have not only failed to harm him, you have made him look like a victim."
skill_check = SubResource("Resource_jauwa")
required_gold = 0
required_manpower = 0
required_food = 0
required_modifier = ""
success_outcomes = Array[ExtResource("2_fogut")]([SubResource("Resource_gahgr")])
failure_outcomes = Array[ExtResource("2_fogut")]([SubResource("Resource_fogut")])
metadata/_custom_type_script = "uid://cohvc8fiel25u"

