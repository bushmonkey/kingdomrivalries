[resource]
script = ExtResource("2_w0v4m")
category = 4
event_id = "SERPENT_S2_A_LOYAL_LORD"
title = "A Loyal Lord's Warning"
unlocked_at_start = true
rarity = 0
cooldown_years = 0
selection_cost = 0
summary = "A loyal noble has discovered a piece of your uncle's conspiracy and has come to warn you."
description = "One of your most loyal vassals requests a secret audience. \"My Liege,\" he whispers, his face pale, \"I must speak plainly. Lord Valerius approached me. He spoke of dissatisfaction, of your 'weak' rule, and of a 'stronger' future. He is building a faction of traitors. I refused him, but others may not. Be warned.\""
vignette_texture = ""
options = Array[ExtResource("1_uhe1d")]([SubResource("Resource_rr8kl"), SubResource("Resource_2jngg")])
