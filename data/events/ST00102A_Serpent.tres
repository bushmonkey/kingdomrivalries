[sub_resource type="Resource" id="Resource_rr8kl"]
script = ExtResource("1_uhe1d")
text = "\"Thank you for your loyalty. Help me uncover the others.\""
success_text = "Working together, you and your loyal vassal identify several key members of your uncle's conspiracy. This knowledge will be invaluable in dismantling their plot when the time is right."
failure_text = "Your attempt to use your loyal vassal as a double agent is discovered. Valerius now knows who the loyalists are and becomes even more secretive."
