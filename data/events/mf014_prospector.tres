[resource]
script = ExtResource("2_8pt07")
category = 3
trigger_conditions = SubResource("Resource_4k0io")
event_id = "MF014"
title = "The Dwarven Prospector"
unlocked_at_start = true
rarity = 1
cooldown_years = 0
selection_cost = 50
summary = "A mysterious, bearded prospector claiming to be from a lost Dwarven clan offers to reveal a rich vein of gold in your mountains... for a price."
description = "A stout, heavily bearded man in dusty traveler's clothes arrives at your court. He introduces himself as Borin, a prospector from the ancient clans of the mountains. \"Your miners scratch the surface, King,\" he says in a gravelly voice. \"But the true wealth, the Motherlode, lies deeper. I can show you where to dig. My fee is steep, but the riches you'll find will repay it a hundredfold.\""
vignette_texture = ""
options = Array[ExtResource("1_2n3ew")]([SubResource("Resource_lno3e"), SubResource("Resource_22237")])
metadata/_custom_type_script = "uid://cv44sc5a1ixbf"
