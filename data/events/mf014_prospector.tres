[sub_resource type="Resource" id="Resource_lno3e"]
script = ExtResource("1_2n3ew")
text = "\"Trust the dwarf. Fund his expedition.\""
success_text = "It's a massive gamble, but it pays off! Borin leads your miners deep into the mountain and, just as he promised, uncovers a breathtaking vein of pure gold. The mine's output will be legendary!"
failure_text = "He was a charlatan. After taking your gold, Borin leads your miners on a week-long wild goose chase before disappearing in the night. You have been swindled."
skill_check = SubResource("Resource_3ll5s")
required_gold = 250
required_manpower = 0
required_food = 0
required_modifier = ""
success_outcomes = Array[ExtResource("2_7iygi")]([SubResource("Resource_l5sid"), SubResource("Resource_7iygi")])
failure_outcomes = Array[ExtResource("2_7iygi")]([SubResource("Resource_lxwfv"), SubResource("Resource_23xgg")])
metadata/_custom_type_script = "uid://cohvc8fiel25u"

[sub_resource type="Resource" id="Resource_22237"]
script = ExtResource("1_2n3ew")
text = "\"There is no such things as ancient lost dwarven clans. The man is a charlatan.  Throw him in the dungeon.\""
success_text = "You don't trust the strange prospector. Your guards seize him. He may have known something, or he may have been a con artist, but now he's just another prisoner."
failure_text = "Failure!"
required_gold = 0
required_manpower = 0
required_food = 0
required_modifier = ""
success_outcomes = Array[ExtResource("2_7iygi")]([])
failure_outcomes = Array[ExtResource("2_7iygi")]([])
metadata/_custom_type_script = "uid://cohvc8fiel25u"

