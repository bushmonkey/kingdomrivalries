[sub_resource type="Resource" id="Resource_rwfr3"]
script = ExtResource("1_fa4cm")
text = "\"Shall we go on a private ride through the royal forests.\""
success_text = "You ride into the seclusion of the King's Wood. Away from the court, the conversation is easy and genuine. You share a private, romantic moment that significantly strengthens your bond."
failure_text = "The seclusion proves awkward rather than romantic. You struggle to find things to talk about, and the long silences are uncomfortable. The outing is a missed opportunity."
