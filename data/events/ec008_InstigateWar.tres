[sub_resource type="Resource" id="Resource_bkk0f"]
script = ExtResource("1_etbdb")
text = "\"They are desperate. Double the price.\""
success_text = "Your neighbor, having no other choice, reluctantly agrees to your exorbitant price. A massive fortune in gold flows into your treasury, but your reputation as a ruthless and opportunistic ruler is cemented."
failure_text = "Outraged by your greed, your neighbor refuses the deal entirely. They will suffer the shortage rather than submit to your extortion. Word of your dishonorable conduct spreads to other courts."
