[sub_resource type="Resource" id="Resource_ngkx1"]
script = ExtResource("1_etbdb")
text = "\"Do it. Their bloodshed will be our gold.\""
success_text = "Your spymaster's work is a masterpiece of deception. A series of carefully orchestrated incidents and forged letters turns the simmering hostility between your neighbors into a raging inferno. They declare war on each other, just as you planned. Now is the time to profit."
failure_text = "Your plot is discovered! A clumsy agent is captured, and under torture, he reveals everything. You have made some powerful enemies today."
skill_check = SubResource("Resource_etbdb")
required_gold = 0
required_manpower = 0
required_food = 0
required_modifier = ""
success_outcomes = Array[ExtResource("2_1nwpc")]([SubResource("Resource_s8n8c"), SubResource("Resource_grndg")])
failure_outcomes = Array[ExtResource("2_1nwpc")]([SubResource("Resource_1nwpc"), SubResource("Resource_rwocg")])
metadata/_custom_type_script = "uid://cohvc8fiel25u"

