[resource]
script = ExtResource("4_grndg")
category = 1
trigger_conditions = SubResource("Resource_jd54b")
event_id = "EC008"
title = "Vultures Scheme"
unlocked_at_start = true
rarity = 2
cooldown_years = 0
selection_cost = 75
summary = "Your steward has identified two neighboring kingdoms with simmering tensions. You could secretly push them into a war for your own profit."
description = "Your steward and spymaster present you with a unique and dangerous opportunity. The kingdoms of {target1_kingdom_name} and {target2_kingdom_name} have a history of bad blood. Their relations are poor, and their rulers despise one another.

\"My Liege,\" your spymaster whispers, \"a few well-placed rumors, a forged letter, a 'stray' border patrol... a small push is all that would be needed to ignite the flames of war between them. A war from which we could profit immensely.\""
vignette_texture = ""
options = Array[ExtResource("1_etbdb")]([SubResource("Resource_ngkx1"), SubResource("Resource_hhvfi"), SubResource("Resource_bkk0f")])
