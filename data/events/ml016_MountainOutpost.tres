[sub_resource type="Resource" id="Resource_3mmtq"]
script = ExtResource("1_ou1gm")
text = "\"Build the outpost. Secure our border.\""
success_text = "The mountain fortress is constructed. It stands as a grim sentinel, guarding the pass. Your kingdom is now virtually impenetrable from that direction, a fact that will give any potential invader pause."
failure_text = "The construction is a disaster. A rockslide destroys the half-finished outpost, and the project is abandoned. The effort was a costly failure."
skill_check = SubResource("Resource_natu7")
required_gold = 150
required_manpower = 0
required_food = 0
required_modifier = ""
success_outcomes = Array[ExtResource("2_61prq")]([SubResource("Resource_pf1t8"), SubResource("Resource_rtc11")])
failure_outcomes = Array[ExtResource("2_61prq")]([SubResource("Resource_61prq"), SubResource("Resource_d7d6y")])
metadata/_custom_type_script = "uid://cohvc8fiel25u"

[sub_resource type="Resource" id="Resource_d34yl"]
