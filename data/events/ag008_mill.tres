[sub_resource type="Resource" id="Resource_14774"]
script = ExtResource("1_8jcjq")
text = "Side with the peasants. Order him to lower the toll."
success_text = "Your command is firm and just. Lord Aldred, though furious, knows he cannot defy a royal decree. He lowers the toll. The peasants are overjoyed, and your reputation as a just ruler grows."
failure_text = "Your order is weak and unconvincing. Lord Aldred sees it as a suggestion, not a command, and ignores it. You have failed to help your people and have lost face with the nobility."
skill_check = SubResource("Resource_yojsk")
required_gold = 0
required_manpower = 0
required_food = 0
required_modifier = ""
success_outcomes = Array[ExtResource("2_pbowb")]([SubResource("Resource_cjm8p"), SubResource("Resource_cur21")])
failure_outcomes = Array[ExtResource("2_pbowb")]([SubResource("Resource_pbowb"), SubResource("Resource_6alqq")])
