[sub_resource type="Resource" id="Resource_q5jhp"]
script = ExtResource("1_8jcjq")
text = "\"Build a Crown Mill. Create competition.\""
success_text = "You fund the construction of a new mill owned by the crown, with fair and fixed prices. The peasants flock to it, and Lord Aldred is forced to lower his own prices to compete. You have solved the problem and gained a new source of income."
failure_text = "The Crown Mill is a disaster. Poorly built and inefficient, it cannot compete with Aldred's established mill. The project is a costly failure."
skill_check = SubResource("Resource_hkdso")
required_gold = 200
required_manpower = 0
required_food = 0
required_modifier = ""
success_outcomes = Array[ExtResource("2_pbowb")]([SubResource("Resource_2dyvo"), SubResource("Resource_q88at")])
failure_outcomes = Array[ExtResource("2_pbowb")]([SubResource("Resource_m6214"), SubResource("Resource_a58xw")])
metadata/_custom_type_script = "uid://cohvc8fiel25u"

[resource]
script = ExtResource("2_4pd1x")
category = 2
event_id = "AG008"
title = "The Miller's Toll"
unlocked_at_start = true
rarity = 0
cooldown_years = 0
selection_cost = 0
summary = "A local lord has increased the toll at his grain mill, and the peasants are on the verge of rioting."
description = "A delegation of angry peasants stands before you, their spokesman clutching his hat in his hands. \"My Liege,\" he pleads, \"Lord Aldred has doubled the toll to use his grain mill! He takes nearly a quarter of our flour. It is pure greed! We cannot feed our families. We beg you to intervene.\"

Later, Lord Aldred argues his case. \"The mill is on MY land. The peasants will pay what I demand. It is my right as a noble!\""
vignette_texture = ""
options = Array[ExtResource("1_8jcjq")]([SubResource("Resource_14774"), SubResource("Resource_ygk0o"), SubResource("Resource_q5jhp")])
metadata/_custom_type_script = "uid://cv44sc5a1ixbf"
