[resource]
script = ExtResource("2_jbubo")
category = 2
trigger_conditions = SubResource("Resource_r5jv2")
event_id = "AG012"
title = "The Salmon Run"
unlocked_at_start = true
rarity = 0
cooldown_years = 0
selection_cost = 0
summary = "The annual salmon run is larger than anyone can remember, offering a massive but perishable bounty."
description = "Fishermen from the river mouths are ecstatic. The annual salmon run has begun, and the rivers are so thick with fish you could almost walk across their backs! It is a massive, unexpected bounty of rich food. However, the fish will rot quickly if not preserved or sold at once."
vignette_texture = ""
options = Array[ExtResource("1_rhbac")]([SubResource("Resource_lx563"), SubResource("Resource_ikgyw"), SubResource("Resource_qvqqv")])
