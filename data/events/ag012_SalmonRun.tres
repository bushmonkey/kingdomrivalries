[sub_resource type="Resource" id="Resource_lx563"]
script = ExtResource("1_rhbac")
text = "\"Buy the entire catch for the royal stores.\""
success_text = "Your steward acts with incredible efficiency, organizing the purchase, salting, and smoking of the entire catch. The royal granaries are now overflowing with preserved fish, a massive boost to your food security for the coming years."
failure_text = "The logistics are a nightmare. Much of the fish spoils due to a lack of salt and space. You have spent a good deal of gold for only a modest increase in your food stores."
required_gold = 0
required_manpower = 0
required_food = 0
required_modifier = ""
success_outcomes = Array[ExtResource("2_rlaux")]([SubResource("Resource_rlaux"), SubResource("Resource_mr7lr")])
failure_outcomes = Array[ExtResource("2_rlaux")]([SubResource("Resource_rlaux"), SubResource("Resource_c0qrl")])
