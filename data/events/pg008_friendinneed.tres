[resource]
script = ExtResource("2_omsg8")
category = 6
event_id = "PG008"
title = "A Friend in Need"
unlocked_at_start = false
rarity = 1
cooldown_years = 0
selection_cost = 50
summary = "Your childhood friend, {friend_name}, has sent an urgent letter requesting your help."
description = "A messenger arrives bearing the personal seal of your childhood friend, [b]{friend_name}[/b]. The letter is written in a hurried, desperate hand.

\"My King,\" it reads, \"I am in grave trouble. I have falsely been accused of treason. I am to be arrested and likely executed. I am innocent, I swear it on our friendship. I beg you, intervene on my behalf. A word from a king like you is my only hope.\""
vignette_texture = ""
options = Array[ExtResource("1_6f4g3")]([SubResource("Resource_84xk1"), SubResource("Resource_ppk5j")])
metadata/_custom_type_script = "uid://cv44sc5a1ixbf"
