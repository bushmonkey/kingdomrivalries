[sub_resource type="Resource" id="Resource_84xk1"]
script = ExtResource("1_6f4g3")
text = "\"Send an envoy. Demand they release my friend.\""
success_text = "You send a strongly worded letter to your friend's court. Intimidated by your authority and unwilling to risk a diplomatic incident over a minor courtier, they grudgingly agree to release your friend. A few weeks later, a grateful {friend_name} arrives at your court, now a loyal and permanent member of your council."
failure_text = "Your demand is seen as an arrogant overreach. You receive a curt reply: \"Mind your own realm's affairs.\" 
{friend_name} is made an example of, executed  publicly as a show of strength. You have failed, and your friend is dead."
skill_check = SubResource("Resource_g6isi")
required_gold = 0
required_manpower = 0
required_food = 0
required_modifier = ""
success_outcomes = Array[ExtResource("2_b1fv8")]([SubResource("Resource_elyry"), SubResource("Resource_0y0pk")])
failure_outcomes = Array[ExtResource("2_b1fv8")]([SubResource("Resource_b1fv8"), SubResource("Resource_tqyyr")])
metadata/_custom_type_script = "uid://cohvc8fiel25u"

