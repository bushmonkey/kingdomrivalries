[sub_resource type="Resource" id="Resource_ppk5j"]
script = ExtResource("1_6f4g3")
text = "\"I cannot risk a war for one person. I will do nothing.\""
success_text = "You send no reply. It is a cold but pragmatic decision. A few seasons later, you hear that your friend was quietly executed. You have preserved the peace and stability of your realm, but the memory of your choice, and your friend's last plea, weighs heavily upon you."
failure_text = "Failure!"
required_gold = 0
required_manpower = 0
required_food = 0
required_modifier = ""
