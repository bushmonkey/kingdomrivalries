[sub_resource type="Resource" id="Resource_wnn44"]
script = ExtResource("1_fi50n")
text = "\"Ruin his reputation with a subtle rumor.\""
success_text = "Your spymaster discreetly spreads a scandalous (and entirely fabricated) rumor about the young knight. His reputation is tarnished, and he is no longer seen as a suitable match. {girlfriend_name} now only has eyes for you."
failure_text = "The rumor is so clumsy that it is immediately traced back to you. You are seen as a petty and dishonorable schemer. The plot backfires spectacularly, making your rival look like a victim of your jealousy."
skill_check = SubResource("Resource_66va1")
required_gold = 0
required_manpower = 0
required_food = 0
required_modifier = ""
success_outcomes = Array[ExtResource("2_e1m8l")]([SubResource("Resource_7lbbn")])
failure_outcomes = Array[ExtResource("2_e1m8l")]([SubResource("Resource_q370q"), SubResource("Resource_tktuy")])
