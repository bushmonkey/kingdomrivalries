[sub_resource type="Resource" id="Resource_xgtro"]
script = ExtResource("1_fi50n")
text = "\"Challenge him to a duel. I will prove my superiority.\" "
success_text = "You challenge the knight to a \"friendly\" spar in the training yard. You fight with skill and vigor, soundly defeating him in front of the entire court. {girlfriend_name} is clearly impressed by your prowess."
failure_text = "The duel is a humiliation. The young knight is faster and more skilled, and he bests you easily. You have only succeeded in making yourself look weak and foolish in front of the woman you are trying to woo."
skill_check = SubResource("Resource_3aipu")
