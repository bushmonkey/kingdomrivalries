[resource]
script = ExtResource("2_3ax6u")
category = 2
trigger_conditions = SubResource("Resource_tft7n")
event_id = "AG011"
title = "The Great Elk"
unlocked_at_start = true
rarity = 0
cooldown_years = 0
selection_cost = 0
summary = "Scouts have spotted a magnificent Great Elk in the royal forests, presenting a rare and prestigious hunting opportunity."
description = "Your Royal Huntsman bursts into court, his eyes wide with excitement. \"My Liege, we have sighted it! The Great Elk of the Whisperwood, a beast of legend with antlers like a throne! To bring down such a creature would be a feat spoken of for generations. The hunt is dangerous, but the glory... and the feast... would be unparalleled.\""
vignette_texture = ""
options = Array[ExtResource("1_wu5mf")]([SubResource("Resource_3xv2x"), SubResource("Resource_miy3c"), SubResource("Resource_l4qii")])
