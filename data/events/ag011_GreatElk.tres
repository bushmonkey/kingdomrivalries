[sub_resource type="Resource" id="Resource_3xv2x"]
script = ExtResource("1_wu5mf")
text = "\"I shall lead the hunt myself!\""
success_text = "You lead the hunt with masterful skill. After a long and thrilling chase, you bring down the magnificent beast with a single, perfectly aimed arrow. The court is awed by your prowess, and the resulting feast is a legendary affair, bolstering the spirits of the entire kingdom."
failure_text = "The hunt is a disaster. The Great Elk outwits your trackers at every turn. After days of fruitless searching, you return empty-handed and exhausted. The court whispers about the beast that humbled their king."
skill_check = SubResource("Resource_mvak8")
required_gold = 0
required_manpower = 0
required_food = 0
required_modifier = ""
success_outcomes = Array[ExtResource("2_5rjja")]([SubResource("Resource_45mmc"), SubResource("Resource_falkr"), SubResource("Resource_7jmjt")])
failure_outcomes = Array[ExtResource("2_5rjja")]([SubResource("Resource_5rjja"), SubResource("Resource_bsipw")])
metadata/_custom_type_script = "uid://cohvc8fiel25u"

